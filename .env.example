# Copy to .env (never commit .env). Live calls use the EU data zone deployment.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Deployment names, written by infra/up.sh.
MODEL_LIVE=gpt-5.5-live
MODEL_OFFLINE=gpt-5.5-offline
# Optional API settings (defaults in backend/app/config.py):
# MISTAKE_REASONING_EFFORT=none  TRANSCRIBE_REASONING_EFFORT=none  (gpt-5.5: none|low|medium|high|xhigh)
# MATH_TIMEOUT_S=3  MATH_WORKERS=2  TRUST_PROXY=false (the Docker image sets true: only the ingress reaches it)
# RATE_MISTAKE_PER_MIN=20  RATE_TRANSCRIBE_PER_MIN=10  RATE_CHECK_WORKING_PER_MIN=60
